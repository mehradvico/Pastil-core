@using Application.Common.Dto.Result
@using Application.Common.Helpers
@using Application.Services.Order.PaymentSrv.Dto
@model BaseResultDto<PaymentDto>

@{
    ViewData["Title"] = "بازگشت از پرداخت";
    var isSuccess = Model?.IsSuccess == true;
    var returnUrl = TempData["ReturnToSiteUrl"]?.ToString() ?? AppSettingsHelper.BaseUrl;
}

<section class="payment-shell @(isSuccess ? "is-success" : "is-failed")">
    <main class="payment-card" aria-labelledby="payment-result-title">
        <header class="brand">
            <img class="brand-logo" src="~/Assets/Payment/images/Logo.png" alt="پاستیل" />
        </header>

        <div class="status-icon" aria-hidden="true">
            @if (isSuccess)
            {
                <svg width="82" height="82" viewBox="0 0 82 82" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="41" cy="41" r="37" stroke="#29C778" stroke-width="4" />
                    <path d="M24 41.5L35.5 53L59 29.5" stroke="#29C778" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            }
            else
            {
                <svg width="82" height="82" viewBox="0 0 82 82" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="41" cy="41" r="37" stroke="#FF5D68" stroke-width="4" />
                    <path d="M29 29L53 53M53 29L29 53" stroke="#FF5D68" stroke-width="6" stroke-linecap="round" />
                </svg>
            }
        </div>

        <h1 id="payment-result-title">
            @(isSuccess ? "پرداخت با موفقیت انجام شد" : "پرداخت شما ناموفق بود.")
        </h1>

        <a class="btn-return" href="@returnUrl">
            <span>بازگشت به اپ پاستیل</span>
            <span class="return-arrow" aria-hidden="true">←</span>
        </a>

        <footer class="security-note">پرداخت امن پاستیل</footer>
    </main>
</section>
