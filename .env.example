# Copy this file to .env and fill the values locally.
# Never put real credentials in this example file.

PASTIL_API_CONNECTION=
PASTIL_PAYMENT_CONNECTION=
PASTIL_FILE_CONNECTION=
PASTIL_REALTIME_CONNECTION=
PASTIL_JWT_KEY=
PASTIL_MERCHANT_ENCRYPTION_KEY=
PASTIL_BANKCARD_ENCRYPTION_KEY=
PASTIL_ALLOWED_HOSTS=api.pastil.pet;file.pastil.pet;payment.pastil.pet;localhost;127.0.0.1;pastil-api;pastil-file;pastil-payment
PASTIL_AREA_POLICY_MODE=Audit
PASTIL_OTP_LENGTH=4
PASTIL_SECURITY_ALERT_WEBHOOK_URL=
PASTIL_SECURITY_ALERT_TELEGRAM_BOT_TOKEN=
PASTIL_SECURITY_ALERT_TELEGRAM_CHAT_ID=
PASTIL_PASSWORD_PEPPER=
# Shared secret (>= 32 chars) that lets the webapp server vouch for the real visitor IP used by
# per-IP rate limits. Must equal the webapp container's NUXT_CLIENT_IP_ATTESTATION_KEY.
PASTIL_CLIENT_IP_ATTESTATION_KEY=
PASTIL_VAPID_PUBLIC_KEY=
PASTIL_VAPID_PRIVATE_KEY=
PASTIL_FCM_SERVICE_ACCOUNT_JSON_BASE64=

PASTIL_AI_GEMINI_API_KEY=
PASTIL_AI_GROQ_API_KEY=
PASTIL_AI_OPENAI_API_KEY=
PASTIL_AI_DEEPSEEK_API_KEY=
PASTIL_AI_AVALAI_API_KEY=
PASTIL_AI_GAPGPT_API_KEY=
PASTIL_SEARCH_HYBRID_ENABLED=false
PASTIL_SEARCH_HYBRID_ENDPOINT=
PASTIL_SEARCH_HYBRID_API_KEY=
PASTIL_SEARCH_HYBRID_WEIGHT=0.25
PASTIL_SHIPPING_TEST_MODE=true
PASTIL_SHIPPING_ALOPEYK_BASE_URL=
PASTIL_SHIPPING_ALOPEYK_API_KEY=
PASTIL_SHIPPING_TIPAX_BASE_URL=
PASTIL_SHIPPING_TIPAX_API_KEY=
PASTIL_SHIPPING_SNAPPBOX_BASE_URL=
PASTIL_SHIPPING_SNAPPBOX_API_KEY=
PASTIL_SHIPPING_MIARE_BASE_URL=
PASTIL_SHIPPING_MIARE_API_KEY=
PASTIL_SHIPPING_MIARE_ACCOUNTING_BASE_URL=
PASTIL_AI_LIARA_API_KEY=
